rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@gym.com';
    }

    match /gyms/{gymId}/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
